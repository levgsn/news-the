# IMPORTANT: keep the variable name as DATABASE_URL — the code looks for
# this exact name. Only the VALUE changes depending on where you're running:
#
# - Running locally (your own laptop): use the PUBLIC connection string.
#   In Railway, click your Postgres service -> Variables tab -> copy the
#   value of DATABASE_PUBLIC_URL (looks like
#   postgresql://postgres:PASSWORD@REGION.railway.app:PORT/railway) and
#   paste it here as DATABASE_URL's value.
# - Running as a deployed Railway service: Railway auto-injects its own
#   internal DATABASE_URL for you — you don't need to set this file at all
#   in production, only locally.
#
# DATABASE_PUBLIC_URL and DATABASE_URL (as shown in Railway's dashboard) are
# TWO DIFFERENT VALUES for the same database — the private one only works
# from inside Railway's network and will fail with ECONNREFUSED from your
# own machine. Always use the PUBLIC one for local dev.
DATABASE_URL=postgres://user:password@localhost:5432/news_the

# Port the web server listens on (Railway sets this automatically in prod)
PORT=3000

# How far back (hours) a story can still be matched to an existing cluster
CLUSTER_WINDOW_HOURS=48

# Similarity score (0-1) above which two headlines are considered the same story
CLUSTER_SIMILARITY_THRESHOLD=0.35

# Shared secret for /admin/song?key=... (the daily-song scheduler page).
# Leave unset to disable the admin page entirely. Keep this private.
ADMIN_KEY=change-me-to-something-random
